// Configuration for local development and tests. Real deployments live in
// ../deployments/<app>/wrangler.jsonc and point to this same code.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nongrata-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nongrata-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  // Test app. The APPLE_DC_KEY_P8_DEMO secret goes in .dev.vars (outside git).
  "vars": {
    "HASH_PREFIX_DEMO": "demo-ban-v1",
    "ENFORCE_DEMO": "true",
    "APPLE_TEAM_ID_DEMO": "TEAM000000",
    "APPLE_KEY_ID_DEMO": "KEY0000000"
  }
}
