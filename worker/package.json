{
  "name": "@device-guard/worker",
  "version": "0.1.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p test",
    "types": "wrangler types src/worker-configuration.d.ts",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "test:mutation": "stryker run"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.2",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.0"
  }
}
