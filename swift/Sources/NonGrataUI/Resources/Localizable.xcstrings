{
  "sourceLanguage" : "en",
  "strings" : {
    "nongrata.suspended.message" : {
      "comment" : "Explanation under the title of the blocking screen. \"The code below\" is the support code.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device can't use the app. If you think this is a mistake, contact support and give them the code below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo no puede usar la app. Si crees que es un error, contacta con soporte y facilita el código de abajo."
          }
        }
      }
    },
    "nongrata.suspended.supportCode" : {
      "comment" : "Label above the 8-character code the user reads out to support.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Support code"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Código de soporte"
          }
        }
      }
    },
    "nongrata.suspended.title" : {
      "comment" : "Title of the screen shown when this device is blocked.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access suspended"
          }
