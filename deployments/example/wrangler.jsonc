// Deployment template for one app. Copy it to deployments/<your-app>/ (git ignores those
// folders, because they hold your account's IDs) and change `myapp` and the values in <>.
// Code and migrations are shared from ../../worker.
//
// Secrets (they do not go here), from worker/:
//   pnpm exec wrangler secret put ADMIN_TOKEN --config ../deployments/<your-app>/wrangler.jsonc
//   pnpm exec wrangler secret put APPLE_DC_KEY_P8_MYAPP --config ../deployments/<your-app>/wrangler.jsonc < AuthKey_<KEY_ID>.p8
{
  "$schema": "../../worker/node_modules/wrangler/config-schema.json",
  "name": "nongrata-myapp",
  "main": "../../worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nongrata-myapp",
      // Returned by `wrangler d1 create nongrata-myapp`.
      "database_id": "<DATABASE_ID>",
      "migrations_dir": "../../worker/migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      // A different number for each rate limiter in your Cloudflare account.
      "namespace_id": "<NAMESPACE_ID>",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  // Daily check_log purge (30-day retention).
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    // Each variable's suffix is the SDK's `app` uppercased, with "-" as "_".
    "HASH_PREFIX_MYAPP": "myapp-ban-v1",
    // Observation mode: logs the verdict but lets everyone in. "true" to block.
    "ENFORCE_MYAPP": "false",
    // Without all three Apple pieces (these two and the secret), the Worker decides with D1 alone.
    "APPLE_TEAM_ID_MYAPP": "<TEAM_ID>",
    "APPLE_KEY_ID_MYAPP": "<KEY_ID>"
  },
  // No request bodies logged (docs/HANDOFF.md, section 11).
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
